# Mural API Configuration
# Copy this file to .env and replace with your actual credentials.
#
# These are read only by the local dev server's proxy (vite.config.ts) and are
# never sent to the browser. Do NOT prefix them with VITE_: Vite bundles VITE_
# variables into client code, which would expose your API key.

# Your Mural API key (required)
MURAL_API_KEY=your_mural_api_key_here
MURAL_API_URL=https://api-staging.muralpay.com
